# i-Share .gitignore (derived from the Flutter template; secrets and generated files are never committed)

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Android Native
/android/app/debug
/android/app/profile
/android/app/release
/android/.gradle/
/android/app/build/

# iOS Native
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/App.framework
ios/Flutter/Generated.xcconfig

# macOS Native
macos/Pods/
macos/Flutter/Flutter-macOS.framework
macos/Flutter/GeneratedPluginRegistrant.swift
macos/Flutter/ephemeral/

# Web Native
/web/build/

# Windows/Linux Native
/generated_plugin_registrant.cc

# Debug and Crash logs
crash*.log
*.log
crash_log.txt

# Firebase & Secrets
google-services.json
GoogleService-Info.plist
firebase_options.dart
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist

*.pem
*.key

# Signing secrets — NEVER commit these
android/key.properties
*.jks
*.keystore

# Node.js (Cloud Functions)
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Large/temp files
*.zip
bugreport-*.zip

# Editor directories and files
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Secrets and local configuration (copy the *.example files, never commit the real ones) ----
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
.firebaserc
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
Secrets.xcconfig
ios/Flutter/Secrets.xcconfig
**/service-account*.json
**/serviceAccount*.json
**/key.properties
key.properties
local.properties
*.jks
*.keystore
*.p12
*.mobileprovision
*.p8
**/google-services.json
**/GoogleService-Info.plist
admin_dashboard/lib/firebase_options.dart
admin_dashboard/firebase.json

# ---- Documents, crash dumps and local tooling ----
*.docx
hs_err_pid*
.claude/
CLAUDE.md
.vscode/
*.iml

# ---- Build outputs and dependencies ----
build/
admin_dashboard/build/
.gradle/
.cxx/
.kotlin/
Pods/
**/node_modules/
coverage/
functions/lib/
**/dist/
.flutter-plugins-dependencies

# ---- Generated platform glue (recreated by `flutter pub get`) ----
**/GeneratedPluginRegistrant.*
**/generated_plugin_registrant.*
**/generated_plugins.cmake
**/Generated.xcconfig
**/flutter_export_environment.sh
