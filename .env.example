# Copy to .env (git-ignored) and fill in your own keys.
# .env is bundled as a Flutter asset (see pubspec.yaml) and read by
# lib/core/constants/api_keys.dart; the Android build also reads
# GOOGLE_MAPS_API_KEY from it (android/app/build.gradle.kts).
# Restrict both keys in Google Cloud Console (application + API restrictions).

# Maps SDK key: GoogleMap widget and geocoding
GOOGLE_MAPS_API_KEY=

# Places API key: place autocomplete (HTTP calls from Dart)
GOOGLE_PLACES_API_KEY=
